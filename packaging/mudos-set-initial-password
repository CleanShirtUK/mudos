#!/usr/bin/python3
"""Narrow first-run-only setter for the single managed Linux account."""

import json
import os
import subprocess
import sys


ACCOUNT = "lulu"
STATE = "/home/lulu/.config/lulu/onboarding.json"


def main() -> int:
    if os.geteuid() != 0 or len(sys.argv) != 1:
        return 2
    try:
        try:
            with open(STATE, encoding="utf-8") as stream:
                state = json.load(stream)
        except FileNotFoundError:
            state = {"status": "never"}
        if (not isinstance(state, dict)
                or state.get("status") not in {"never", "partial", "dismissed"}
                or state.get("admin_password_configured", False)):
            return 3
        lines = sys.stdin.buffer.read(2050).splitlines()
        if len(lines) != 2 or lines[0] != lines[1]:
            return 4
        password = lines[0]
        if (len(password) < 8 or len(password) > 1024
                or any(byte in password for byte in (b"\0", b"\n", b"\r", b":"))):
            return 5
        result = subprocess.run(
            # Explicit YESCRYPT hashing uses the system's configured password
            # hash without invoking PAM's optional password-composition checks.
            ["/usr/sbin/chpasswd", "--crypt-method", "YESCRYPT"],
            input=ACCOUNT.encode() + b":" + password + b"\n",
            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, check=False,
            timeout=20,
        )
        if result.returncode:
            diagnostic = result.stderr.decode("utf-8", errors="replace").strip().splitlines()
            print(diagnostic[0][:180] if diagnostic else "chpasswd failed", file=sys.stderr)
            return 6
        # A user may have accumulated failed attempts while the first-run
        # password flow was being debugged. Clear those before the caller
        # verifies the freshly written credential through PAM.
        subprocess.run(["/usr/bin/faillock", "--user", ACCOUNT, "--reset"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       check=False, timeout=10)
        return 0
    except (OSError, ValueError, subprocess.SubprocessError):
        return 7


if __name__ == "__main__":
    raise SystemExit(main())
