[Unit]
Description=Mudos administration Web UI
After=network.target

[Service]
Type=simple
User=lulu
Group=lulu
Environment=PYTHONPATH=/opt/lulu/current/lib
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=LULU_INSTALL_ROOT=/opt/lulu/current
Environment=HOME=/home/lulu
Environment=XDG_CONFIG_HOME=/home/lulu/.config
Environment=XDG_DATA_HOME=/home/lulu/.local/share
EnvironmentFile=/etc/lulu/mudos-recovery-token
ExecStart=/usr/bin/python -m lulu.admin_web
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
# pkexec needs to switch credentials, and the allowlisted helper needs to read
# the first-run state and update the protected shadow database.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_FOWNER CAP_AUDIT_WRITE
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# ProtectSystem's read-only /etc mount prevents chpasswd from atomically
# creating its temporary account-database files. This daemon runs as lulu;
# privileged writes are available only through the polkit-allowlisted helper.
ProtectSystem=off
# Optional provider directories are absent on a fresh appliance until their
# OOBE components are selected. Prefixes make absent paths non-fatal while
# retaining the sandbox allowance when those providers are installed.
ReadWritePaths=/home/lulu/.config/lulu /home/lulu/.local/share/lulu -/home/lulu/Games -/var/lib/nzbget -/var/lib/lulu-transmission

[Install]
WantedBy=multi-user.target
