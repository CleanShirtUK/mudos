// Allow the lulu session account to restart only the active Mudos VT2 session.
// Sessiond requests this through systemd so the owning unit performs a clean
// stop, waits for prerequisites, and starts Gamescope again.
polkit.addRule(function(action, subject) {
    if (subject.user == "lulu" &&
        action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "lulu-session@2.service" &&
        action.lookup("verb") == "restart") {
        return polkit.Result.YES;
    }
});
