// Permit only the fixed first-run password helper; it accepts no account or
// command arguments and checks the persisted OOBE eligibility itself.
polkit.addRule(function(action, subject) {
    if (subject.user == "lulu" &&
        action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/libexec/mudos-set-initial-password") {
        return polkit.Result.YES;
    }
});
