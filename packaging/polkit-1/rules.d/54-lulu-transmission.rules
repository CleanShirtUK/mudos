// Permit only Mudos Admin to stop and start the managed Transmission unit.
// Credential materialization remains confined to Transmission's private
// directory; no generic system-service management is granted.
polkit.addRule(function(action, subject) {
    if (subject.user == "lulu" &&
        action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "lulu-transmission.service" &&
        (action.lookup("verb") == "stop" || action.lookup("verb") == "start")) {
        return polkit.Result.YES;
    }
});
