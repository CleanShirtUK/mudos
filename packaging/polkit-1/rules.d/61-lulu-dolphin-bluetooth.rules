// The root helper accepts only acquire/release and the configured adapter.
polkit.addRule(function(action, subject) {
    if (subject.user == "lulu" &&
        action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/opt/lulu/current/scripts/dolphin-bluetooth-lease.py") {
        return polkit.Result.YES;
    }
});
