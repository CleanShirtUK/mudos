[Unit]
Description=Restricted Questarr appliance PAM authenticator
After=local-fs.target

[Service]
Type=simple
User=root
Group=lulu
Environment=HOME=/root
Environment=PYTHONPATH=/opt/lulu/current/lib
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=LULU_INSTALL_ROOT=/opt/lulu/current
Environment=LULU_QUESTARR_PAM_ACCOUNT=josh
RuntimeDirectory=lulu-questarr-pam
RuntimeDirectoryMode=0750
UMask=0007
ExecStart=/usr/bin/python -m lulu.questarr_pam_auth
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/lulu-questarr-pam /run/faillock
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID

[Install]
WantedBy=multi-user.target
