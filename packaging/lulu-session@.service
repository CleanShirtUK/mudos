[Unit]
Description=Lulu graphical console session on VT %i
Requires=seatd.service user-runtime-dir@958.service user@958.service
Wants=inputplumber.service lulu-osk@%i.service lulu-consoled.service lulu-acquisition.service lulu-steam-runtime.service
PartOf=inputplumber.service
After=seatd.service inputplumber.service systemd-logind.service systemd-user-sessions.service user-runtime-dir@958.service user@958.service lulu-steam-runtime.service
Conflicts=getty@tty%i.service
Before=getty@tty%i.service
StartLimitIntervalSec=60s
StartLimitBurst=5
OnFailure=mudos-recovery-guard.service

[Service]
Type=notify
NotifyAccess=main
User=lulu
PAMName=lulu-session
TTYPath=/dev/tty%i
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
WorkingDirectory=/home/lulu
Environment=PYTHONPATH=/opt/lulu/lib
Environment=LULU_AURELIA_EXECUTABLE=/usr/bin/aurelia
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=LULU_INSTALL_ROOT=/opt/lulu/current
Environment=HOME=/home/lulu
Environment=USER=lulu
Environment=LOGNAME=lulu
Environment=XDG_CONFIG_HOME=/home/lulu/.config
Environment=XDG_DATA_HOME=/home/lulu/.local/share
Environment=XDG_CACHE_HOME=/home/lulu/.cache
Environment=REAL_HOME=/home/lulu
Environment=REAL_XDG_CONFIG_HOME=/home/lulu/.config
Environment=REAL_XDG_DATA_HOME=/home/lulu/.local/share
Environment=REAL_XDG_CACHE_HOME=/home/lulu/.cache
Environment=XDG_RUNTIME_DIR=/run/user/958
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/958/bus
Environment=LULU_NATIVE_CONTROLLER=1
EnvironmentFile=-/etc/lulu/presentation.conf
ExecStartPre=+/opt/lulu/bin/lulu-vt activate %i
ExecStart=/usr/bin/python -m lulu.sessiond --bootstrap-shell
Restart=on-failure
RestartSec=2s
TimeoutStopSec=20s
KillMode=mixed

[Install]
WantedBy=lulu.target
