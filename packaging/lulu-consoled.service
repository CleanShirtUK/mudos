[Unit]
Description=Lulu game catalogue service
Requires=user@958.service
After=user@958.service lulu-session@2.service

[Service]
Type=simple
User=lulu
Environment=PYTHONPATH=/opt/lulu/lib
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=LULU_INSTALL_ROOT=/opt/lulu/current
Environment=HOME=/home/lulu
Environment=USER=lulu
Environment=LOGNAME=lulu
Environment=XDG_CONFIG_HOME=/home/lulu/.config
Environment=XDG_DATA_HOME=/home/lulu/.local/share
Environment=XDG_CACHE_HOME=/home/lulu/.cache
Environment=REAL_HOME=/home/lulu
Environment=REAL_XDG_CONFIG_HOME=/home/lulu/.config
Environment=REAL_XDG_DATA_HOME=/home/lulu/.local/share
Environment=REAL_XDG_CACHE_HOME=/home/lulu/.cache
Environment=XDG_RUNTIME_DIR=/run/user/958
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/958/bus
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/lulu/.Xauthority
Environment=WAYLAND_DISPLAY=gamescope-0
Environment=PULSE_SERVER=unix:/run/user/958/pulse/native
ExecStart=/usr/bin/python -m lulu.consoled
Restart=on-failure
RestartSec=2s
