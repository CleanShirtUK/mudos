# Reconcile capability-selected InputPlumber profiles on gamepad add/remove.
# The generator also distinguishes IP source nodes from generated outputs.
ACTION=="add|remove", SUBSYSTEM=="input", KERNEL=="event[0-9]*", ENV{ID_INPUT_JOYSTICK}=="1", TAG+="systemd", ENV{SYSTEMD_WANTS}+="lulu-inputplumber-hotplug.service"
