Window.SetBackgroundTopColor(0.043, 0.051, 0.071);
Window.SetBackgroundBottomColor(0.043, 0.051, 0.071);

logo_image = Image("mudos-wordmark.png");
logo_sprite = Sprite(logo_image);
logo_sprite.SetPosition(Window.GetWidth() / 2 - logo_image.GetWidth() / 2,
                        Window.GetHeight() / 2 - logo_image.GetHeight() / 2, 10000);
