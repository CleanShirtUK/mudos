[Unit]
Description=Questarr game storefront
StartLimitIntervalSec=300
StartLimitBurst=3
After=network-online.target lulu-transmission.service nzbget.service
Wants=network-online.target

[Service]
Type=simple
RuntimeDirectory=lulu-questarr
RuntimeDirectoryMode=0755
ExecStartPre=-/usr/bin/podman rm -f questarr
ExecStart=/opt/lulu/current/bin/mudos-questarr
ExecStop=/usr/bin/podman stop -t 20 questarr
ExecStopPost=-/usr/bin/podman rm -f questarr
ExecStopPost=/usr/bin/rm -f /run/lulu-questarr/verified-image-id
Restart=on-failure
RestartSec=30
TimeoutStartSec=180
TimeoutStopSec=40
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
