#!/usr/bin/bash
set -eu

app=dev.eden_emu.eden
# Sessiond selects the owned game surface by Xwayland XID. Eden's Flatpak
# otherwise prefers native Wayland, which never enters that candidate set.
args=("--nosocket=wayland" "--env=QT_QPA_PLATFORM=xcb")

# SwitchProvider emits this AppImage-runtime flag for native Eden releases;
# the Flathub build is launched directly and receives the remaining game args.
if [ "${1:-}" = "--appimage-extract-and-run" ]; then
    shift
fi

# Eden stores keys and installed firmware in its user-data/NAND tree and does
# not provide config keys for either path. Mudos projects its canonical files
# there as symlinks, then grants the backing storage read-only at invocation.
if [ -n "${MUDOS_EDEN_KEYS_DIR:-}" ]; then
    args+=("--filesystem=$MUDOS_EDEN_KEYS_DIR:ro")
fi
if [ -n "${MUDOS_EDEN_FIRMWARE_DIR:-}" ]; then
    args+=("--filesystem=$MUDOS_EDEN_FIRMWARE_DIR:ro")
fi
if [ -n "${MUDOS_EDEN_GAME_DIR:-}" ]; then
    args+=("--filesystem=$MUDOS_EDEN_GAME_DIR:ro")
fi

exec /usr/bin/flatpak run --system "${args[@]}" "$app" "$@"
