[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Path
Target = usr/lib/modules/*/vmlinuz
Target = usr/lib/modules/*/pkgbase

[Action]
Description = Validating Mudos Limine boot defaults...
When = PostTransaction
Exec = /usr/bin/python /opt/lulu/current/scripts/configure-mudos-limine.py --config /boot/limine.conf --limine-defaults /etc/default/limine
NeedsTargets
