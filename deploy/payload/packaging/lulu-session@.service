[Unit]
Description=Lulu graphical console session on VT %i
Requires=seatd.service user-runtime-dir@958.service user@958.service
Wants=inputplumber.service
PartOf=inputplumber.service
After=seatd.service inputplumber.service systemd-logind.service systemd-user-sessions.service user-runtime-dir@958.service user@958.service
Conflicts=getty@tty%i.service
Before=getty@tty%i.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User=lulu
PAMName=lulu-session
TTYPath=/dev/tty%i
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
WorkingDirectory=/home/lulu
Environment=PYTHONPATH=/opt/lulu/lib
Environment=HOME=/home/lulu
Environment=USER=lulu
Environment=LOGNAME=lulu
Environment=XDG_CONFIG_HOME=/home/lulu/.config
Environment=XDG_DATA_HOME=/home/lulu/.local/share
Environment=XDG_CACHE_HOME=/home/lulu/.cache
Environment=LULU_NATIVE_CONTROLLER=1
EnvironmentFile=-/etc/lulu/presentation.conf
ExecStartPre=+/opt/lulu/bin/lulu-vt activate %i
ExecStart=/usr/bin/python -m lulu.sessiond --bootstrap-shell
ExecStopPost=+/opt/lulu/bin/lulu-vt restore
Restart=always
RestartSec=2s
TimeoutStopSec=20s
KillMode=mixed

[Install]
WantedBy=lulu.target
