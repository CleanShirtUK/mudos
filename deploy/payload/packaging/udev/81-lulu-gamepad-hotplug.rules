# Reconcile capability-selected InputPlumber profiles on physical gamepad
# add/remove. The generator additionally requires a non-empty physical path.
ACTION=="add|remove", SUBSYSTEM=="input", KERNEL=="event[0-9]*", ENV{ID_INPUT_JOYSTICK}=="1", TAG+="systemd", ENV{SYSTEMD_WANTS}+="lulu-inputplumber-hotplug.service"
