#!/bin/sh
set -eu

runtime=${XDG_RUNTIME_DIR:-/run/user/958}
socket="$runtime/mudos-osk-bridge.sock"
[ -S "$socket" ] || { echo "Mudos OSK bridge is not running" >&2; exit 1; }

# The bridge owns the gamepad-osk child and the InputPlumber mode transition.
# This boundary must never launch the raw application or inspect eventN.
# Supported operations are show|hide|status.
PYTHONPATH= python3 - "$socket" "${1:-status}" <<'PY'
import socket
import sys

path, command = sys.argv[1:]
with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
    client.settimeout(2.0)
    client.connect(path)
    client.sendall((command + "\n").encode())
    reply = client.recv(64).decode().strip()
if not reply.startswith("ok "):
    raise SystemExit(reply.removeprefix("error ") or "Mudos OSK request failed")
print(reply[3:])
PY
