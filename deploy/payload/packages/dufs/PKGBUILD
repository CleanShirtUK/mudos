pkgname=dufs
pkgver=0.46.0
pkgrel=1
pkgdesc='A file server supporting static serving, uploading, and WebDAV'
arch=('x86_64' 'aarch64')
url='https://github.com/sigoden/dufs'
license=('MIT' 'Apache')
makedepends=('cargo')
source=("https://crates.io/api/v1/crates/${pkgname}/${pkgver}/download")
sha256sums=('fcd9d9cf7dd2a04d4b01b87a021ab3bec693f81d6d66484dbca15a3bac593177')

prepare() {
    cd "$pkgname-$pkgver"
    cargo fetch --locked
}

build() {
    cd "$pkgname-$pkgver"
    cargo build --release --locked
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 "target/release/dufs" "$pkgdir/usr/bin/dufs"
    install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
    install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
