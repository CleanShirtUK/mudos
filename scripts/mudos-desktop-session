#!/usr/bin/env bash
set -euo pipefail
runtime="${XDG_RUNTIME_DIR:?}/mudos-desktop"
mkdir -p "$runtime/config/openbox" "$runtime/config/tint2" "$runtime/logs"
chmod 700 "$runtime"
config="$runtime/config"
auth="$runtime/Xauthority"
install_root="${LULU_INSTALL_ROOT:-/opt/lulu/current}"
app_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
mkdir -p "$app_dir"
for desktop_file in "$install_root"/packaging/desktop-applications/*.desktop; do
    if [[ -f "$desktop_file" ]]; then
        sed "s|/opt/lulu/current|$install_root|g" "$desktop_file" > "$app_dir/$(basename "$desktop_file")"
        chmod 644 "$app_dir/$(basename "$desktop_file")"
    fi
done
children=()
cleanup() {
    trap - EXIT INT TERM HUP
    for pid in "${children[@]}"; do kill "$pid" 2>/dev/null || true; done
    for pid in "${children[@]}"; do wait "$pid" 2>/dev/null || true; done
    rm -f "$auth"
}
trap cleanup EXIT
trap 'exit 0' INT TERM HUP
outer="${DISPLAY:-:0}"; outer_number="${outer#:}"; outer_number="${outer_number%%.*}"
number=91
while [[ -e "/tmp/.X${number}-lock" || -e "/tmp/.X11-unix/X${number}" || "$number" == "$outer_number" ]]; do ((number+=1)); done
display=":${number}"
cookie="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
: > "$auth"; chmod 600 "$auth"
xauth -f "$auth" add "$display" MIT-MAGIC-COOKIE-1 "$cookie"
theme="$("$install_root/bin/mudos-desktop-theme" 2>/dev/null || printf '{}')"
background="$(python -c 'import json,sys; print(json.loads(sys.argv[1]).get("surface", "#202124"))' "$theme")"
for binary in Xephyr xauth xdpyinfo xrandr xsetroot xprop openbox tint2 jgmenu; do
    command -v "$binary" >/dev/null 2>&1 || { echo "Desktop Mode requires missing binary: $binary" >&2; exit 1; }
done
[[ -x "$install_root/bin/mudos-desktop-wallpaper" ]] || { echo "Desktop Mode wallpaper host missing: $install_root/bin/mudos-desktop-wallpaper" >&2; exit 1; }
python - "$theme" "$config" "$install_root" <<'PY'
import json,pathlib,sys
import re
t=json.loads(sys.argv[1]); root=pathlib.Path(sys.argv[2])
install_root=sys.argv[3]
def col(k,d): return t.get(k,d)
r=max(0,min(10,int(t.get('radius',6))))
template=pathlib.Path('/etc/xdg/tint2/tint2rc').read_text()
if 'panel_items = LTSC' not in template:
    raise SystemExit('installed tint2 default template is missing expected panel_items setting')
template=template.replace('panel_items = LTSC','panel_items = PPPPTSC',1)
template=template.replace('panel_size = 100% 30','panel_size = 100% 36',1)
template=template.replace('panel_padding = 2 0 2','panel_padding = 8 4 6',1)
template=template.replace('panel_layer = top','panel_layer = normal',1)
template=template.replace('time1_format = %H:%M','time1_format = %a %d %b %H:%M',1)
template=template.replace('time1_format = %a %d %b %H:%M','time1_format = %a %d %b %H:%M\ntime1_font = Sans 9',1)
template=template.replace('clock_font_color = #ffffff 100',f"clock_font_color = {col('secondaryText','#cccccc')} 100",1)
template=template.replace('task_font_color = #ffffff 100',f"task_font = Sans 9\ntask_font_color = {col('primaryText','#eeeeee')} 100",1)
template=template.replace('task_font_color = #ffffff 100',f"task_font_color = {col('primaryText','#eeeeee')} 100",1)
template=template.replace('taskbar_name_font_color = #e3e3e3 100',f"taskbar_name_font_color = {col('secondaryText','#cccccc')} 100",1)
template=template.replace('taskbar_name_active_font_color = #ffffff 100',f"taskbar_name_active_font_color = {col('primaryText','#eeeeee')} 100",1)
groups={1:('surface','border'),2:('surface','border'),3:('accent','focus'),4:('accent','focus'),5:('surface','border')}
background=0; lines=[]
for line in template.splitlines():
    match=re.match(r'# Background (\d+):',line)
    if match: background=int(match.group(1))
    if line.startswith('rounded = '): line=f'rounded = {r}'
    if background in groups:
        bg,border=groups[background]
        for key,role,fallback in (
            ('background_color = ',bg,'#292a2d'),('background_color_hover = ',bg,'#292a2d'),
            ('background_color_pressed = ',bg,'#292a2d'),('border_color = ',border,'#555555'),
            ('border_color_hover = ',border,'#555555'),('border_color_pressed = ',border,'#555555')):
            if line.startswith(key): line=f'{key}{col(role,fallback)} 100'
    lines.append(line)
template='\n'.join(lines)+f'''\n
button = new
button_text = Menu
button_font = Sans 9
button_font_color = {col('primaryText','#eeeeee')} 100
button_lclick_command = {install_root}/scripts/mudos-desktop-menu {root}/jgmenurc
button = new
button_text = Wi-Fi
button_font = Sans 9
button_font_color = {col('accent','#80cbc4')} 100
button_lclick_command = {install_root}/scripts/mudos-desktop-settings network
button = new
button_text = Bluetooth
button_font = Sans 9
button_font_color = {col('accent','#80cbc4')} 100
button_lclick_command = {install_root}/scripts/mudos-desktop-settings bluetooth
button = new
button_text = Power
button_font = Sans 9
button_font_color = {col('primaryText','#eeeeee')} 100
button_lclick_command = jgmenu --config-file={root}/jgmenurc --csv-file={root}/power.csv
'''
(root/'tint2/tint2rc').write_text(template)
(root/'power.csv').write_text(f'''^tag(main)
Restart, ^checkout(restart)
Shutdown, ^checkout(shutdown)
Exit Desktop Mode, exec: {install_root}/scripts/mudos-desktop-sessionctl exit
^tag(restart)
Confirm Restart, exec: {install_root}/scripts/mudos-desktop-sessionctl reboot
^tag(shutdown)
Confirm Shutdown, exec: {install_root}/scripts/mudos-desktop-sessionctl shutdown
''')
(root/'jgmenurc').write_text(f'''tint2_look = 0
stay_alive = 0
menu_width = 260
menu_radius = {r}
menu_border = 1
color_menu_bg = {col('surface','#292a2d')} 100
color_menu_border = {col('border','#555555')} 100
color_norm_bg = {col('surface','#292a2d')} 100
color_norm_fg = {col('primaryText','#eeeeee')} 100
color_sel_bg = {col('accent','#80cbc4')} 100
color_sel_fg = {col('background','#202124')} 100
''')
(root/'openbox/rc.xml').write_text('''<?xml version="1.0"?>
<openbox_config xmlns="http://openbox.org/3.4/rc"><keyboard/><mouse/><menu/><applications/>
<focus><focusNew>yes</focusNew><followMouse>no</followMouse></focus><placement><policy>Smart</policy></placement>
<theme><name>Clearlooks</name><titleLayout>NLIMC</titleLayout></theme><desktops><number>1</number></desktops>
<margins><top>0</top><bottom>40</bottom><left>0</left><right>0</right></margins></openbox_config>\n''')
PY
# Resolve the actual active Gamescope/Xwayland surface, not EDID or a test
# resolution. 1024x768 is the documented safe fallback if both X queries fail.
outer_size=''
if outer_info="$(DISPLAY="$outer" xdpyinfo 2>/dev/null)"; then
    outer_size="$(printf '%s\n' "$outer_info" | sed -nE 's/^[[:space:]]*dimensions:[[:space:]]*([0-9]+x[0-9]+).*/\1/p' | head -n1)"
fi
if [[ ! "$outer_size" =~ ^([1-9][0-9]{1,4})x([1-9][0-9]{1,4})$ ]] \
        || (( ${BASH_REMATCH[1]:-0} < 160 || ${BASH_REMATCH[2]:-0} < 160 )); then
    outer_size="$(DISPLAY="$outer" xrandr --current 2>/dev/null | sed -nE 's/.*current ([0-9]+) x ([0-9]+),.*/\1x\2/p' | head -n1)"
fi
if [[ ! "$outer_size" =~ ^([1-9][0-9]{1,4})x([1-9][0-9]{1,4})$ ]] \
        || (( ${BASH_REMATCH[1]:-0} < 160 || ${BASH_REMATCH[2]:-0} < 160 )); then
    echo "WARNING: cannot query valid dimensions from outer DISPLAY=$outer; using safe fallback 1024x768" >&2
    outer_size=1024x768
fi
width="${BASH_REMATCH[1]}"; height="${BASH_REMATCH[2]}"
if (( width > 32767 || height > 32767 )); then echo "outer display is outside Xephyr limits: $outer_size" >&2; exit 1; fi
echo "outer DISPLAY=$outer dimensions=$outer_size; Xephyr DISPLAY=$display" >>"$runtime/logs/session.log"
Xephyr "$display" -screen "0 $outer_size" -dpi 96 -resizeable -auth "$auth" -nolisten tcp -title 'Mudos Desktop Mode' >"$runtime/logs/xephyr.log" 2>&1 &
xephyr=$!; children+=("$xephyr")
for _ in $(seq 1 100); do
    kill -0 "$xephyr" 2>/dev/null || exit 1
    if DISPLAY="$display" XAUTHORITY="$auth" xdpyinfo >/dev/null 2>&1; then break; fi
    sleep .1
done
dimensions="$(DISPLAY="$display" XAUTHORITY="$auth" xdpyinfo 2>/dev/null | sed -nE 's/^[[:space:]]*dimensions:[[:space:]]*([0-9]+x[0-9]+).*/\1/p' | head -n1)"
if [[ "$dimensions" != "$outer_size" ]]; then echo "Xephyr root dimensions mismatch: expected $outer_size, got ${dimensions:-unknown}" >&2; exit 1; fi
echo "Xephyr root dimensions=$dimensions; dpi=96" >>"$runtime/logs/session.log"
desktop=(env DISPLAY="$display" XAUTHORITY="$auth")
"${desktop[@]}" openbox --config-file "$config/openbox/rc.xml" &
wm=$!; children+=("$wm")
wm_ready=0
for _ in $(seq 1 100); do
    kill -0 "$wm" 2>/dev/null || break
    if "${desktop[@]}" xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | grep -q 'window id'; then wm_ready=1; break; fi
    sleep .1
done
if (( ! wm_ready )); then echo 'Openbox did not become ready on nested display' >&2; exit 1; fi
"${desktop[@]}" xsetroot -solid "$background"
"${desktop[@]}" env QT_QPA_PLATFORM=xcb LULU_UI_ROOT="$install_root/ui" \
    "$install_root/bin/mudos-desktop-wallpaper" >"$runtime/logs/wallpaper.log" 2>&1 &
wallpaper=$!; children+=("$wallpaper")
start_panel() {
    "${desktop[@]}" tint2 -c "$config/tint2/tint2rc" >"$runtime/logs/tint2.log" 2>&1 &
    panel=$!
    for _ in $(seq 1 30); do
        kill -0 "$panel" 2>/dev/null || return 1
        if "${desktop[@]}" xprop -root -notype 2>/dev/null >/dev/null; then
            # tint2 has parsed configuration and remained alive through X connection.
            sleep .2
            kill -0 "$panel" 2>/dev/null && return 0
        fi
        sleep .1
    done
    return 1
}
panel=''
if start_panel; then children+=("$panel"); else
    wait "$panel" 2>/dev/null || status=$?
    echo "tint2 initial launch failed (status ${status:-unknown}); retrying once" >>"$runtime/logs/tint2.log"
    if start_panel; then children+=("$panel"); else
        wait "$panel" 2>/dev/null || status=$?
        echo "FAULT: tint2 failed after bounded retry (status ${status:-unknown}); desktop remains available" >>"$runtime/logs/tint2.log"
        panel=''
    fi
fi
panel_restarted=0
while kill -0 "$xephyr" 2>/dev/null && kill -0 "$wm" 2>/dev/null; do
    if [[ -n "$panel" ]] && ! kill -0 "$panel" 2>/dev/null; then
        wait "$panel" 2>/dev/null || true
        if (( ! panel_restarted )); then
            panel_restarted=1
            echo 'tint2 exited unexpectedly; attempting one bounded restart' >>"$runtime/logs/tint2.log"
            if start_panel; then children+=("$panel"); else
                wait "$panel" 2>/dev/null || status=$?
                echo "FAULT: tint2 restart failed (status ${status:-unknown}); wallpaper/Openbox remain usable" >>"$runtime/logs/tint2.log"
                panel=''
            fi
        else
            echo 'FAULT: tint2 exited after its bounded restart; wallpaper/Openbox remain usable' >>"$runtime/logs/tint2.log"
            panel=''
        fi
    elif [[ -z "$panel" ]]; then
        : # A persistent panel fault must not take down the desktop.
    fi
    if [[ -n "$wallpaper" ]] && ! kill -0 "$wallpaper" 2>/dev/null; then
        wait "$wallpaper" 2>/dev/null || status=$?
        echo "FAULT: wallpaper renderer exited (status ${status:-unknown}); semantic root color remains" >>"$runtime/logs/wallpaper.log"
        wallpaper=''
    fi
    sleep 1
done
