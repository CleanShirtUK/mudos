#!/usr/bin/env bash
set -euo pipefail
export PYTHONDONTWRITEBYTECODE=1

mounts=$(HOME=/home/lulu XDG_CONFIG_HOME=/home/lulu/.config \
  PYTHONPATH=/opt/lulu/current/lib /usr/bin/python -c '
import json
import pwd
import stat
from lulu.paths import PATHS
from lulu.questarr_paths import questarr_library_mounts
uid = pwd.getpwnam("lulu").pw_uid
gid = pwd.getpwnam("lulu").pw_gid
def lulu_can_write(path):
    info = path.stat()
    if info.st_mode & stat.S_IWOTH:
        return False
    owner_write = info.st_uid == uid and info.st_mode & stat.S_IWUSR
    group_write = info.st_gid == gid and info.st_mode & stat.S_IWGRP
    return bool(owner_write or group_write)
values = [str(PATHS.torrent_root), str(PATHS.usenet_root), str(PATHS.usenet_complete_root)]
for mount in questarr_library_mounts():
    if not mount.host_path.is_dir() or not lulu_can_write(mount.host_path):
        raise SystemExit("Mudos ROM platform path is not safely writable by lulu: " + str(mount.host_path))
    values.extend((str(mount.host_path), str(mount.container_path)))
print(json.dumps(values))')
readarray -t host_paths < <(printf '%s' "$mounts" | /usr/bin/python -c \
  'import json,sys; print("\n".join(json.load(sys.stdin)))')
[[ ${#host_paths[@]} -ge 3 && $(( (${#host_paths[@]} - 3) % 2 )) -eq 0 \
   && -d ${host_paths[0]} && -d ${host_paths[1]} && -d ${host_paths[2]} ]] || {
  echo "Questarr Mudos storage projections are unavailable; configure a valid Mudos storage target." >&2
  exit 78
}
for ((index=3; index<${#host_paths[@]}; index+=2)); do
  [[ -d ${host_paths[index]} && ${host_paths[index+1]} == /data/* ]] || {
    echo "Questarr platform library projection is unavailable." >&2
    exit 78
  }
done
library_volumes=()
for ((index=3; index<${#host_paths[@]}; index+=2)); do
  library_volumes+=(--volume "${host_paths[index]}:${host_paths[index+1]}:rw")
done
image_ref=$(</var/lib/lulu-questarr/questarr-image-ref)
[[ $image_ref =~ ^sha256:[0-9a-f]{64}$ ]] || {
  echo "The reproducibly built Mudos Questarr image is not pinned." >&2
  exit 78
}
ready_marker=/run/lulu-questarr/verified-image-id
rm -f "$ready_marker"
cleanup() {
  rm -f "$ready_marker"
  /usr/bin/podman stop --time 20 questarr >/dev/null 2>&1 || true
}
trap cleanup EXIT
/usr/bin/podman run --detach --name questarr --network host --user root \
  --env PUID=958 --env PGID=958 --env PORT=5002 --env HOST=127.0.0.1 \
  --env NODE_ENV=production --env SQLITE_DB_PATH=/app/data/sqlite.db \
  --volume /var/lib/lulu-questarr/data:/app/data:Z \
  --volume "${host_paths[0]}:/home/lulu/Games/.acquisition/torrents:ro" \
  --volume "${host_paths[1]}:/home/lulu/Games/.acquisition/usenet:ro" \
  --volume "${host_paths[2]}:/home/lulu/Games/.acquisition/usenet/complete:rw" \
  "${library_volumes[@]}" \
  "$image_ref"

for attempt in {1..180}; do
  active_image=$(/usr/bin/podman inspect --format '{{.Image}}' questarr 2>/dev/null || true)
  if [[ $active_image == "$image_ref" ]] && \
      /usr/bin/curl --silent --show-error --fail http://127.0.0.1:5002/api/health >/dev/null 2>&1 && \
      /usr/bin/podman exec --user 958:958 questarr test -d /data/Wii && \
      /usr/bin/podman exec --user 958:958 questarr test -w /data/Wii && \
      /usr/bin/podman exec --user 958:958 questarr test -r /home/lulu/Games/.acquisition/usenet/complete && \
      /usr/bin/podman exec --user 958:958 \
        --env QUESTARR_VERIFY_DESTDIR=/home/lulu/Games/.acquisition/usenet/complete/ \
        questarr node --input-type=module -e "$(</opt/lulu/current/scripts/verify-questarr-runtime.mjs)" \
        >/dev/null; then
    printf '%s\n' "$active_image" > "$ready_marker"
    chmod 0644 "$ready_marker"
    break
  fi
  if ((attempt == 180)); then
    echo "Pinned Questarr image or container path/client verification failed." >&2
    /usr/bin/podman logs --tail 100 questarr >&2 || true
    exit 1
  fi
  sleep 1
done

/usr/bin/podman logs --follow questarr
