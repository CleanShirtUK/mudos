# Mudos optional provider/service configuration.
#
# Precedence: built-in safe defaults, /etc/lulu/provider-services.toml,
# $XDG_CONFIG_HOME/lulu/provider-services.toml, then the file named by
# LULU_PROVIDER_CONFIG (development/testing override).
#
# Secret values never belong in this file. Store them with SecretStore and put
# only a namespace/name reference in the secrets table.

[metadata.steamgriddb]
enabled = false
endpoint = "https://www.steamgriddb.com/api"
timeout = 4.0

[metadata.steamgriddb.secrets]
api_key = "steamgriddb/api-key"

[metadata.igdb]
enabled = false
client_id = ""
endpoint = "https://api.igdb.com/v4"
auth_endpoint = "https://id.twitch.tv/oauth2/token"
timeout = 5.0

[metadata.igdb.secrets]
client_secret = "igdb/client-secret"

[metadata.protondb]
enabled = false
endpoint = "https://www.protondb.com/api/v1/reports/summaries"
timeout = 4.0

[providers.steam_aurelia]
enabled = true

[providers.prowlarr]
enabled = false
endpoint = "http://192.168.0.197:9696/"

[providers.prowlarr.secrets]
api_key = "prowlarr/api-key"

# Future services use the same namespace boundary when implemented:
# [providers.lutris]
# [providers.flatpak]
# [providers.torrent]
# enabled = false
# backend = "transmission"
# endpoint = "http://127.0.0.1:9091/transmission/rpc"
# timeout_seconds = 10
# label = "mudos"
#
# [providers.torrent.secrets]
# username = "torrent/rpc-username"
# password = "torrent/rpc-password"
# [providers.usenet]
